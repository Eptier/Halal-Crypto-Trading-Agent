# =============================================================================
# halal-trading-agent — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you need.
# DO NOT commit `.env` to git.

# -----------------------------------------------------------------------------
# Trading mode
# -----------------------------------------------------------------------------
# `paper` (default, simulated, no real money) | `live` (REAL MONEY)
# Live mode also requires a committed `enable_live.md` file at the repo root
# acknowledging the risks. See docs/live-trading-checklist.md.
TRADING_MODE=paper

# Exchange (any CCXT spot exchange — binance recommended)
EXCHANGE=binance

# Quote currency used for buying (USDT widely available, halal status disputed
# by some scholars — see docs/halal-coins.md). Use BUSD or USDC if preferred.
QUOTE_CURRENCY=USDT

# Starting equity in QUOTE_CURRENCY (paper mode only — live uses real balance)
PAPER_STARTING_EQUITY=1000

# -----------------------------------------------------------------------------
# Exchange API credentials (LIVE MODE ONLY)
# -----------------------------------------------------------------------------
# Create on Binance: Profile -> API Management -> Create API
# Permissions: ENABLE Spot Trading, DISABLE Futures, DISABLE Withdrawals
# IP whitelist your server.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# -----------------------------------------------------------------------------
# Risk parameters (hard caps — code refuses to bypass)
# -----------------------------------------------------------------------------
MAX_POSITION_PCT=0.20         # max 20% of equity in any single position
MAX_OPEN_POSITIONS=3          # max simultaneous open positions
MAX_DAILY_LOSS_PCT=0.05       # 5% daily loss -> auto-shutdown
STOP_LOSS_PCT=0.05            # 5% stop-loss per position
TAKE_PROFIT_PCT=0.10          # 10% take-profit per position
MIN_TRADE_QUOTE=10            # min trade size in quote currency

# -----------------------------------------------------------------------------
# Loop cadence
# -----------------------------------------------------------------------------
RESEARCH_INTERVAL_SECONDS=300   # 5 min between research cycles
TRADING_INTERVAL_SECONDS=60     # 1 min between trading-loop ticks

# -----------------------------------------------------------------------------
# Optional: LLM-powered research agent
# -----------------------------------------------------------------------------
# If unset, the bot falls back to a deterministic rule-based research agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/agent.db
LOG_LEVEL=INFO
