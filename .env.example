# ===== Silent Money Machine — Environment Configuration =====

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_BASIC=price_basic_id
STRIPE_PRICE_PRO=price_pro_id

# Email (Resend or SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Database
DATABASE_URL=sqlite+aiosqlite:///./silent_money_machine.db

# API Security
API_SECRET_KEY=your-super-secret-key-change-this
API_KEY_HEADER=X-API-Key

# App Settings
APP_NAME=Silent Money Machine
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Scheduler
SCHEDULER_ENABLED=true
CONTENT_GENERATION_HOUR=6
OUTREACH_HOUR=9
PRODUCT_GENERATION_HOUR=3

# Outreach
DAILY_OUTREACH_LIMIT=50
FOLLOW_UP_DAYS=3,7,14
